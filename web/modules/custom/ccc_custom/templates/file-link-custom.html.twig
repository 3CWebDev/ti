{#
/**
 * @file
 * Default theme implementation for a link to a file.
 *
 * Available variables:
 * - attributes: The HTML attributes for the containing element.
 * - link: A link to the file.
 * - file_size: The size of the file.
 *
 * @see template_preprocess_file_link_custom()
 *
 * @ingroup themeable
 */
#}

<div class="owner-pdf">
    <div><span{{ attributes }}><a target="_blank" href="{{ url }}"><img src="/sites/default/files/images/download-pdf-button.png" alt="download pdf"></a></span></div>
    {% if description %}
        <div class="owner-description"><a target="_blank" href="{{ url }}">{{ description }}</a></div>
    {% else %}
        <a target="_blank" href="{{ url }}"> {{ file.filename.value }}</a>
    {% endif %}

</div>